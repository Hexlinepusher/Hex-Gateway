root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{md,mdx}]
trim_trailing_whitespace = false
max_line_length = off
[LICENSE]
max_line_length = off
[*.{patch,diff}]
trim_trailing_whitespace = false
max_line_length = off
[*.lock]
max_line_length = off

[{Makefile,*.mk}]
indent_style = tab
[*.{bat,cmd}]
end_of_line = crlf
